<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="./local.props" Condition="Exists('./local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <RootNamespace>QuickRestart</RootNamespace>
    <!-- 与 QuickRestart.json 的 version、Entry.ModVersion 三处保持一致。
         ⚠️ 本工程 GenerateAssemblyInfo=false（不生成程序集版本特性），所以这个 Version 只影响
         MSBuild 产物元数据、运行期读不到 —— 日志里的版本号必须用 Entry.ModVersion。 -->
    <Version>0.1.6</Version>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" Private="false" />
    <!-- RitsuLib v0.6.x 布局适配：类型拆分到 Runtime 程序集（门面 DLL 仅类型转发）。
         存在 Runtime.dll 时自动加引用（0.5.x 单 DLL 布局无此文件，条件自动跳过）。 -->
    <Reference Include="STS2-RitsuLib.Runtime" Condition="Exists('$(RitsuLibDir)/STS2-RitsuLib.Runtime.dll')" HintPath="$(RitsuLibDir)/STS2-RitsuLib.Runtime.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="找不到 $(Sts2DataDir)/sts2.dll" />
    <Error Condition="!Exists('$(RitsuLibDir)/STS2-RitsuLib.dll')" Text="找不到 RitsuLib" />
  </Target>

  <Target Name="CopyMod" AfterTargets="Build">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/QuickRestart.json" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>